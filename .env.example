PORT=3005
NODE_ENV=development

# JWT Secret for authentication
JWT_SECRET=your_jwt_secret_key_here

# Supabase Project Database password
SUPABASE_DB_PASSWORD=super_long_strong_password_here

# Prisma SQL Supabase password
PRISMA_SQL_SUPABASE_PASSWORD=super_long_strong_password_here

# Connect to Supabase via connection pooling
DATABASE_URL="postgresql://postgres.your_supabase_user:super_long_strong_password_here"

# Direct connection to the database. Used for migrations
DATABASE_DIRECT_URL="postgresql://postgres.your_supabase_user:super_long_strong_password_here"
